@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Xác Nhận Xóa Đơn Hàng";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-cart-check-fill"></i> Quản lý đơn hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa đơn hàng</li>
        </ol>
    </nav>

    <!-- Hộp cảnh báo màu đỏ nguy hiểm -->
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">CẢNH BÁO: XÓA ĐƠN HÀNG KHỎI HỆ THỐNG!</h5>
            <p class="mb-0 small">Hành động này sẽ xóa đơn hàng và toàn bộ chi tiết đơn đặt hàng tương ứng vĩnh viễn khỏi hệ thống. Bạn có chắc chắn muốn thực hiện?</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-trash3-fill"></i>
                        </span>
                        XÁC NHẬN XÓA ĐƠN HÀNG #@Model.Id
                    </h4>
                    <hr class="mt-3 mb-0 border-light" />
                </div>
                
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center mb-3 mb-md-0 border-end border-light">
                            <span class="p-4 rounded-circle bg-light text-secondary d-inline-flex justify-content-center align-items-center" style="width: 100px; height: 100px; font-size: 3rem;">
                                <i class="bi bi-receipt"></i>
                            </span>
                        </div>

                        <div class="col-md-9 ps-md-4">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 fw-bold text-muted mb-2">Mã đơn hàng (ID):</dt>
                                <dd class="col-sm-8 mb-2 text-dark fw-bold">#@Model.Id</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Ngày đặt hàng:</dt>
                                <dd class="col-sm-8 mb-2 text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Khách hàng đặt:</dt>
                                <dd class="col-sm-8 mb-2 text-dark fw-bold">@(Model.Customer != null ? Model.Customer.FullName : $"ID Khách hàng: {Model.CustomerId}")</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Địa chỉ Email:</dt>
                                <dd class="col-sm-8 mb-2 text-muted">@(Model.Customer?.Email)</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Trạng thái đơn:</dt>
                                <dd class="col-sm-8 mb-2">
                                    @if (Model.Status == 0)
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1">Chờ duyệt</span>
                                    }
                                    else if (Model.Status == 1)
                                    {
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">Đang giao</span>
                                    }
                                    else if (Model.Status == 2)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Đã xong</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">Đã hủy</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-0">Ghi chú giao hàng:</dt>
                                <dd class="col-sm-8 mb-0 text-muted small">@(Model.Notes ?? "Không có ghi chú")</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Chân trang chứa form xác nhận xóa -->
                <div class="card-footer bg-white border-0 py-4 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
                    <span class="text-muted small">Kiểm tra thông số kỹ thuật và số lượng chi tiết trước khi xóa.</span>
                    
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ & Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
                                <i class="bi bi-trash3-fill"></i> Xác nhận xóa đơn hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
