@model IEnumerable<CMS.Data.Entities.Order>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ ĐƠN HÀNG</h2>
        <button class="btn btn-success btn-sm">+ Tạo đơn hàng mới</button>
    </div>
    <table class="table table-hover shadow-sm border">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Ngày đặt hàng</th>
                <th>Khách hàng</th>
                <th>Trạng thái</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if(item.Customer != null)
                        {
                            <strong>@item.Customer.FullName</strong>
                        }
                        else
                        {
                            <span class="text-muted">ID: @item.CustomerId</span>
                        }
                    </td>
                    <td>
                        @if(item.Status == 0)
                        {
                            <span class="badge bg-warning text-dark">Chờ duyệt</span>
                        }
                        else if(item.Status == 1)
                        {
                            <span class="badge bg-info text-dark">Đang giao</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Đã xong</span>
                        }
                    </td>
                    <td>@(item.Notes ?? "Không có ghi chú")</td>
                    <td>
                        <a href="@Url.Action("Details", "Orders", new { id = item.Id })" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                        <button class="btn btn-sm btn-outline-warning">Sửa</button>
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>