@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Cập Nhật Trạng Thái Đơn Hàng";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-cart-check-fill"></i> Quản lý đơn hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật trạng thái</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-pencil-square"></i>
                        </span>
                        CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG #@Model.Id
                    </h3>
                    <p class="text-muted small mb-0">Thay đổi trạng thái xử lý hoặc thêm ghi chú giao nhận của khách hàng.</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <!-- Tóm tắt thông tin đơn hàng hiện tại -->
                    <div class="bg-light rounded-3 p-3 mb-4 border">
                        <div class="row">
                            <div class="col-sm-6 mb-2 mb-sm-0">
                                <span class="text-muted small d-block">Khách hàng đặt mua:</span>
                                <strong class="text-dark">@(Model.Customer != null ? Model.Customer.FullName : $"Khách hàng ID: {Model.CustomerId}")</strong>
                                <span class="text-muted small d-block">@(Model.Customer?.Email)</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Thời gian tạo đơn:</span>
                                <strong class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Thông báo trạng thái nếu có -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: rgba(25, 135, 84, 0.1); color: #198754;">
                            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="background-color: rgba(220, 53, 69, 0.1); color: #dc3545;">
                            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- Danh sách mặt hàng trong đơn hàng -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-cart4 text-primary"></i> DANH SÁCH MẶT HÀNG TRONG ĐƠN HÀNG</label>
                        <div class="table-responsive rounded-3 border">
                            <table class="table table-hover align-middle mb-0" style="font-size: 14px;">
                                <thead class="table-light small text-uppercase text-secondary">
                                    <tr>
                                        <th class="ps-3 py-2" style="width: 50px;">STT</th>
                                        <th class="py-2 text-center" style="width: 70px;">Hình ảnh</th>
                                        <th class="py-2">Tên sản phẩm</th>
                                        <th class="py-2 text-center" style="width: 100px;">Số lượng</th>
                                        <th class="py-2 text-end" style="width: 120px;">Đơn giá</th>
                                        <th class="py-2 text-end" style="width: 130px;">Thành tiền</th>
                                        <th class="pe-3 py-2 text-center" style="width: 100px;">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                                    {
                                        int index = 1;
                                        decimal grandTotal = 0;
                                        foreach (var item in Model.OrderDetails)
                                        {
                                            decimal itemTotal = item.Quantity * item.UnitPrice;
                                            grandTotal += itemTotal;
                                            <tr>
                                                <td class="ps-3 text-secondary">#@index</td>
                                                <td class="text-center">
                                                    <div class="d-flex align-items-center justify-content-center bg-light rounded overflow-hidden border" style="width: 45px; height: 45px; margin: auto;">
                                                        @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                                                        {
                                                            <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-image text-secondary" style="font-size: 1.2rem;"></i>
                                                        }
                                                    </div>
                                                </td>
                                                <td>
                                                    @if (item.Product != null)
                                                    {
                                                        <span class="fw-bold text-dark d-block">@item.Product.Name</span>
                                                        <span class="text-muted small" style="font-size: 11px;">Mã SP: #@item.Product.Id</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Mã SP: #@item.ProductId (Sản phẩm đã bị xóa hoặc ẩn)</span>
                                                    }
                                                </td>
                                                <td class="text-center fw-semibold text-dark">@item.Quantity chiếc</td>
                                                <td class="text-end text-dark">@item.UnitPrice.ToString("N0") đ</td>
                                                <td class="text-end fw-bold text-danger">@itemTotal.ToString("N0") đ</td>
                                                <td class="pe-3 text-center">
                                                    @if (Model.Status == 0)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" onclick="confirmDeleteDetail(@item.Id)">
                                                            <i class="bi bi-trash"></i> Xóa
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary px-2 py-1 rounded-pill" style="font-size: 11px;">Khóa sửa</span>
                                                    }
                                                </td>
                                            </tr>
                                            index++;
                                        }
                                        <tr class="table-light fw-bold">
                                            <td colspan="5" class="text-end py-3 text-uppercase" style="font-size: 12px;">Tổng số tiền đơn hàng:</td>
                                            <td colspan="2" class="pe-3 text-end py-3 text-danger fs-6">@grandTotal.ToString("N0") đ</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-5 text-muted">
                                                <i class="bi bi-cart-x fs-2 d-block mb-2"></i>
                                                Không có sản phẩm nào trong đơn hàng này.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Form ẩn để xóa chi tiết đơn hàng -->
                    <form id="deleteDetailForm" asp-controller="Orders" asp-action="DeleteDetail" method="post" style="display: none;">
                        <input type="hidden" name="id" id="deleteDetailId" />
                    </form>

                    <form asp-action="Edit" method="post">
                        <!-- Trường ẩn giữ Id -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="OrderDate" />

                        <!-- Chọn trạng thái -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold text-dark">Trạng thái xử lý <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-info-circle-fill"></i></span>
                                <select asp-for="Status" class="form-select border-start-0 ps-0" style="background-color: #fff;">
                                    <option value="0">Chờ duyệt (Đơn hàng mới tạo)</option>
                                    <option value="1">Đang giao hàng (Đang vận chuyển)</option>
                                    <option value="2">Đã hoàn thành (Giao dịch xong)</option>
                                    <option value="3">Đã hủy bỏ (Hủy giao dịch)</option>
                                </select>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Ghi chú vận chuyển -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold text-dark">Ghi chú giao hàng / Lý do hủy đơn</label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Nhập địa chỉ cụ thể, giờ giao hàng hoặc lý do nếu hủy đơn..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Các nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end mt-4 border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1 text-dark" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; font-weight: 500;">
                                <i class="bi bi-check-circle-fill"></i> Cập nhật đơn hàng
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmDeleteDetail(detailId) {
            if (confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi đơn hàng không? Hành động này không thể hoàn tác.')) {
                document.getElementById('deleteDetailId').value = detailId;
                document.getElementById('deleteDetailForm').submit();
            }
        }
    </script>
}
