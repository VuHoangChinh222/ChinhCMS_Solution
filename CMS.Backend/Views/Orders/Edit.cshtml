@model CMS.Data.Entities.Order

@{
    ViewData["Title"] = "Cập Nhật Trạng Thái Đơn Hàng";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-cart-check-fill"></i> Quản lý đơn hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật trạng thái</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-pencil-square"></i>
                        </span>
                        CẬP NHẬT TRẠNG THÁI ĐƠN HÀNG #@Model.Id
                    </h3>
                    <p class="text-muted small mb-0">Thay đổi trạng thái xử lý hoặc thêm ghi chú giao nhận của khách hàng.</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <!-- Tóm tắt thông tin đơn hàng hiện tại -->
                    <div class="bg-light rounded-3 p-3 mb-4 border">
                        <div class="row">
                            <div class="col-sm-6 mb-2 mb-sm-0">
                                <span class="text-muted small d-block">Khách hàng đặt mua:</span>
                                <strong class="text-dark">@(Model.Customer != null ? Model.Customer.FullName : $"Khách hàng ID: {Model.CustomerId}")</strong>
                                <span class="text-muted small d-block">@(Model.Customer?.Email)</span>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small d-block">Thời gian tạo đơn:</span>
                                <strong class="text-dark">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post">
                        <!-- Trường ẩn giữ Id -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CustomerId" />
                        <input type="hidden" asp-for="OrderDate" />

                        <!-- Chọn trạng thái -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold text-dark">Trạng thái xử lý <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-info-circle-fill"></i></span>
                                <select asp-for="Status" class="form-select border-start-0 ps-0" style="background-color: #fff;">
                                    <option value="0">Chờ duyệt (Đơn hàng mới tạo)</option>
                                    <option value="1">Đang giao hàng (Đang vận chuyển)</option>
                                    <option value="2">Đã hoàn thành (Giao dịch xong)</option>
                                    <option value="3">Đã hủy bỏ (Hủy giao dịch)</option>
                                </select>
                            </div>
                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Ghi chú vận chuyển -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-bold text-dark">Ghi chú giao hàng / Lý do hủy đơn</label>
                            <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Nhập địa chỉ cụ thể, giờ giao hàng hoặc lý do nếu hủy đơn..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Các nút thao tác -->
                        <div class="d-flex gap-2 justify-content-end mt-4 border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1 text-dark" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; font-weight: 500;">
                                <i class="bi bi-check-circle-fill"></i> Cập nhật đơn hàng
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
