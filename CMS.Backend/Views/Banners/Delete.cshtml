@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Xác Nhận Xóa Banner";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 11/06/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-image"></i> Quản lý Banner</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa banner</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-trash-fill"></i>
                        </span>
                        XÁC NHẬN XÓA BANNER QUẢNG CÁO
                    </h3>
                    <p class="text-danger small mb-0">Hành động này không thể hoàn tác. Bạn có chắc chắn muốn xóa banner này?</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="mb-3">
                                <label class="fw-bold text-dark mb-1">Tên Banner:</label>
                                <div class="text-muted fs-5">@Model.Name</div>
                            </div>
                            <div class="mb-3">
                                <label class="fw-bold text-dark mb-1">Mô tả chi tiết:</label>
                                <p class="text-muted">@Model.Description</p>
                            </div>
                            <div class="mb-3">
                                <label class="fw-bold text-dark mb-1">Trạng thái:</label>
                                <div>
                                    @if (Model.Status == 1)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1">Đang hiển thị</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-1">Đang ẩn</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold text-dark mb-2">Hình ảnh Banner:</label>
                            <div class="rounded overflow-hidden shadow-sm border" style="max-height: 220px;">
                                <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" />
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1">
                                <i class="bi bi-trash-fill"></i> Xóa vĩnh viễn
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>
