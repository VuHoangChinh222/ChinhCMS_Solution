@model CMS.Data.Entities.Banner

@{
    ViewData["Title"] = "Chỉnh Sửa Banner";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 11/06/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-image"></i> Quản lý Banner</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa banner</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-pencil-square"></i>
                        </span>
                        CHỈNH SỬA BANNER QUẢNG CÁO
                    </h3>
                    <p class="text-muted small mb-0">Cập nhật thông tin chi tiết của banner quảng cáo.</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <!-- Trường ẩn để lưu trữ ID và ImageUrl hiện tại -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Trường nhập liệu cho Tên banner -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark">Tên banner <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag-fill"></i></span>
                                <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Nhập tên banner..." style="background-color: #fff;" />
                            </div>
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Trường nhập liệu cho Mô tả banner -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-dark">Mô tả chi tiết / Phụ đề banner</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả chi tiết..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Trường tải lên hình ảnh đại diện -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark">Thay đổi hình ảnh Banner</label>
                            
                            <!-- Hiển thị ảnh hiện tại -->
                            <div class="mb-3">
                                <p class="text-muted small mb-1">Hình ảnh hiện tại:</p>
                                <div class="rounded overflow-hidden shadow-sm" style="max-width: 300px; height: 150px;">
                                    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-100 h-100" style="object-fit: cover;" />
                                </div>
                            </div>

                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-image-fill"></i></span>
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>
                            <span class="text-muted small mt-1 d-block">Để trống nếu bạn không muốn thay đổi hình ảnh của banner.</span>
                        </div>

                        <!-- Trạng thái hiển thị -->
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold text-dark">Trạng thái hiển thị</label>
                            <select asp-for="Status" class="form-select">
                                <option value="1">Hiển thị (Hiện)</option>
                                <option value="0">Ẩn (Không hiển thị)</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Khu vực chứa các nút chức năng của biểu mẫu -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                                <i class="bi bi-save-fill"></i> Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
