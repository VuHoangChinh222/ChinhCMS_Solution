@*
    Thư mục chứa giao diện xác nhận xóa danh mục bài viết
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Xác nhận xóa danh mục";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 21/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu liên kết với trang hiển thị này là một đối tượng danh mục *@
@model CMS.Data.Entities.Category

<div class="container mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Category">Danh sách danh mục</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa danh mục</li>
        </ol>
    </nav>

    <!-- Hộp cảnh báo màu đỏ của Bootstrap nhắc nhở hành động xóa dữ liệu nguy hiểm -->
    <div class="alert alert-danger d-flex align-items-center" role="alert">
        <div>
            <h4 class="alert-heading fw-bold">CẢNH BÁO: XÓA DỮ LIỆU VĨNH VIỄN!</h4>
            <p class="mb-0">Hành động này không thể hoàn tác. Xin vui lòng kiểm tra kỹ lưỡng các thông tin bên dưới trước khi xác nhận.</p>
        </div>
    </div>

    <!-- Hộp hiển thị chi tiết thông tin danh mục muốn xóa -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light fw-bold text-dark">
            Chi tiết danh mục yêu cầu xóa
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold text-muted">Mã số danh mục (Id):</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold text-muted">Tên danh mục bài viết:</dt>
                <dd class="col-sm-9 fw-bold text-danger">@Model.Name</dd>

                <dt class="col-sm-3 fw-bold text-muted">Mô tả chi tiết:</dt>
                <dd class="col-sm-9">@(Model.Description ?? "Không có mô tả nào cho danh mục này")</dd>
            </dl>
        </div>
    </div>

    <!-- ==========================================
         KIỂM TRA VÀ HIỂN THỊ CÁC BÀI VIẾT LIÊN KẾT
         ========================================== -->
    @if (Model.Posts != null && Model.Posts.Any())
    {
        <!-- Thông báo nhắc nhở người dùng không được phép xóa khi còn bài viết -->
        <div class="alert alert-warning mb-4" role="alert">
            <h5 class="fw-bold">KHÔNG THỂ XÓA DANH MỤC NÀY!</h5>
            <p class="mb-0">Danh mục này hiện đang chứa <strong>@Model.Posts.Count</strong> bài viết. Để bảo vệ dữ liệu không bị lỗi liên kết bảng, bạn <strong>không được phép xóa</strong> danh mục này cho đến khi tất cả các bài viết dưới đây được xóa hoặc chuyển sang danh mục khác.</p>
        </div>

        <!-- Bảng hiển thị danh sách các bài viết thuộc danh mục này -->
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-dark fw-bold">
                Danh sách bài viết thuộc chuyên mục này (@Model.Posts.Count bài viết)
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">ID bài viết</th>
                            <th style="width: 60%;">Tiêu đề bài viết</th>
                            <th style="width: 30%;">Ngày đăng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.Posts)
                        {
                            <tr>
                                <td>@post.Id</td>
                                <td>
                                    <strong>@post.Title</strong>
                                </td>
                                <td>@post.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Thông báo xác nhận danh mục an toàn để xóa -->
        <div class="alert alert-success mb-4" role="alert">
            <h5 class="fw-bold">DANH MỤC AN TOÀN ĐỂ XÓA!</h5>
            <p class="mb-0">Không có bài viết nào thuộc danh mục này. Bạn có thể tiến hành xóa danh mục vĩnh viễn một cách an toàn.</p>
        </div>
    }

    <!-- Biểu mẫu gửi yêu cầu POST thực hiện xóa vĩnh viễn dữ liệu xuống cơ sở dữ liệu -->
    <form asp-action="Delete" method="post">
        <!-- Trường ẩn lưu trữ mã số danh mục cần xóa để gửi lên hàm DeleteConfirmed -->
        <input type="hidden" asp-for="Id" />
        
        <!-- Các nút bấm xác nhận xóa hoặc hủy bỏ hành động -->
        <div class="d-flex gap-2">
            @if (Model.Posts != null && Model.Posts.Any())
            {
                <!-- Nút bấm bị vô hiệu hóa (disabled) nếu danh mục còn chứa bài viết -->
                <button type="submit" class="btn btn-danger" disabled>
                    Xóa bị khóa (Còn bài viết)
                </button>
            }
            else
            {
                <!-- Nút bấm hoạt động bình thường nếu danh mục trống -->
                <button type="submit" class="btn btn-danger">
                    Xác nhận xóa vĩnh viễn
                </button>
            }
            <a asp-action="Index" class="btn btn-secondary"> Hủy bỏ và quay lại </a>
        </div>
    </form>
</div>
