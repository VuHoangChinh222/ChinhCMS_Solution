@*
    Thư mục chứa giao diện chỉnh sửa thông tin danh mục bài viết
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 21/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu liên kết với biểu mẫu này là đối tượng danh mục bài viết *@
@model CMS.Data.Entities.Category

<div class="container mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Category">Danh sách danh mục</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa danh mục</li>
        </ol>
    </nav>

    <!-- Tiêu đề lớn hiển thị trên trang chỉnh sửa -->
    <h2 class="text-warning fw-bold">CHỈNH SỬA DANH MỤC BÀI VIẾT</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <!-- Biểu mẫu gửi dữ liệu cập nhật lên phương thức Edit sử dụng giao thức POST -->
            <form asp-action="Edit" method="post" enctype="multipart/form-data" class="shadow-sm p-4 border rounded bg-white">
                <!-- Khu vực hiển thị thông báo lỗi tổng hợp từ hệ thống kiểm tra dữ liệu -->
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Trường ẩn lưu trữ mã số (Id) của danh mục - cực kỳ quan trọng để hệ thống biết đang cập nhật dòng dữ liệu nào -->
                <input type="hidden" asp-for="Id" />

                <!-- Trường chỉnh sửa Tên danh mục bài viết -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Tên danh mục bài viết:</label>
                    <input asp-for="Name" class="form-control" />
                    <!-- Hiển thị lỗi nếu người dùng nhập tên không hợp lệ -->
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <!-- Trường chỉnh sửa Mô tả danh mục bài viết -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết:</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <!-- Hiển thị lỗi nếu người dùng nhập mô tả không hợp lệ -->
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Hiển thị hình ảnh hiện tại (nếu có) -->
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">Hình ảnh hiện tại:</label>
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail rounded shadow-sm" style="max-height: 120px; object-fit: cover;" />
                    </div>
                }

                <!-- Trường tải lên hình ảnh đại diện mới -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Tải lên hình ảnh mới:</label>
                    <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                    <span class="text-muted small">Hãy chọn hình ảnh mới nếu muốn thay đổi hình ảnh hiện tại.</span>
                </div>

                <!-- Lưu giữ đường dẫn hình ảnh cũ nếu không thay đổi -->
                <input type="hidden" asp-for="ImageUrl" />

                <!-- Khu vực các nút bấm xác nhận cập nhật hoặc hủy bỏ -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        Cập nhật thay đổi
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Hủy bỏ và quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@* Nạp thêm thư viện hỗ trợ kiểm tra dữ liệu trực tiếp ở trình duyệt người dùng *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
