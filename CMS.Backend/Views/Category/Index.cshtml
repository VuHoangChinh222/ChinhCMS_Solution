@*
    Thư mục chứa giao diện danh sách các danh mục bài viết
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Quản lý danh mục";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 15/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu truyền từ controller sang giao diện là một danh sách các danh mục bài viết *@
@model IEnumerable<CMS.Data.Entities.Category>

<div class="container mt-4">
    <!-- Khu vực tiêu đề trang và nút Thêm mới danh mục -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark fw-bold">QUẢN LÝ DANH MỤC BÀI VIẾT</h2>
        <!-- Nút liên kết chuyển đến trang thêm danh mục bài viết mới -->
        <a asp-action="Create" class="btn btn-success btn-sm">
            + Thêm danh mục mới
        </a>
    </div>

    <!-- Bảng danh sách các danh mục bài viết sử dụng Bootstrap -->
    <table class="table table-hover shadow-sm border">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">ID</th>
                <th style="width: 30%;">Tên danh mục bài viết</th>
                <th style="width: 40%;">Mô tả chi tiết</th>
                <th style="width: 20%;" class="text-center">Thao tác xử lý</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                // Duyệt qua từng dòng danh mục trong danh sách được truyền sang
                foreach (var item in Model)
                {
                    <tr>
                        <!-- Mã số danh mục -->
                        <td>@item.Id</td>
                        
                        <!-- Tên danh mục được bôi đậm để tạo điểm nhấn -->
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        
                        <!-- Mô tả danh mục bài viết, hiển thị chữ nhạt nếu bị rỗng -->
                        <td>
                            @(item.Description ?? "Không có mô tả chi tiết")
                        </td>
                        
                        <!-- Cột chứa các nút chức năng Sửa và Xóa danh mục bài viết -->
                        <td class="text-center">
                            <!-- Nút sửa thông tin danh mục, liên kết đến Action Edit trong CategoryController -->
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
                                Sửa
                            </a>
                            
                            <!-- Nút xóa danh mục, liên kết đến Action Delete trong CategoryController -->
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <!-- Hiển thị thông báo thân thiện nếu bảng cơ sở dữ liệu chưa có danh mục nào -->
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">
                        Hệ thống hiện tại chưa có danh mục bài viết nào. Vui lòng bấm vào nút thêm mới để bắt đầu.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
