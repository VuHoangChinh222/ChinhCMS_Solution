@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    Layout = "_LayoutAdmin";
    var order = ViewBag.Order as CMS.Data.Entities.Order;
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Điều hướng -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-cart-check-fill"></i> Quản lý đơn hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết hóa đơn</li>
        </ol>
    </nav>

    @if (order != null)
    {
        <!-- Bảng thông tin hóa đơn tóm tắt (Invoice details card) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4">
            <div class="card-header border-0 bg-white pt-4 px-4 pb-0 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <div>
                    <h3 class="fw-bold text-dark mb-1">HÓA ĐƠN ĐƠN HÀNG #@order.Id</h3>
                    <p class="text-muted small mb-0">Ngày tạo hóa đơn: @order.OrderDate.ToString("dd/MM/yyyy HH:mm:ss")</p>
                </div>
                <div>
                    @if (order.Status == 0)
                    {
                        <span class="badge bg-warning bg-opacity-10 text-warning px-4 py-2 rounded-pill fw-bold fs-6">Chờ duyệt</span>
                    }
                    else if (order.Status == 1)
                    {
                        <span class="badge bg-info bg-opacity-10 text-info px-4 py-2 rounded-pill fw-bold fs-6">Đang giao</span>
                    }
                    else if (order.Status == 2)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success px-4 py-2 rounded-pill fw-bold fs-6">Đã hoàn thành</span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger px-4 py-2 rounded-pill fw-bold fs-6">Đã hủy bỏ</span>
                    }
                </div>
            </div>
            
            <div class="card-body p-4">
                <hr class="mt-0 mb-4 border-light" />
                <div class="row g-4">
                    <!-- Thông tin người mua hàng -->
                    <div class="col-md-6 col-lg-4 border-end border-light">
                        <h6 class="text-secondary fw-bold text-uppercase mb-3" style="font-size: 12px; letter-spacing: 0.5px;"><i class="bi bi-person-fill"></i> Khách hàng mua sắm</h6>
                        @if (order.Customer != null)
                        {
                            <h5 class="fw-bold text-dark mb-1">@order.Customer.FullName</h5>
                            <p class="text-muted small mb-1"><i class="bi bi-envelope"></i> @order.Customer.Email</p>
                            <p class="text-muted small mb-0"><i class="bi bi-telephone"></i> @(order.Customer.Phone ?? "Chưa cập nhật số điện thoại")</p>
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Khách hàng ID: #@order.CustomerId</p>
                        }
                    </div>

                    <!-- Thông tin giao hàng -->
                    <div class="col-md-6 col-lg-5 border-end border-light">
                        <h6 class="text-secondary fw-bold text-uppercase mb-3" style="font-size: 12px; letter-spacing: 0.5px;"><i class="bi bi-geo-alt-fill"></i> Địa chỉ nhận hàng</h6>
                        <p class="text-dark fw-semibold mb-2">
                            @(order.Customer != null && !string.IsNullOrEmpty(order.Customer.Address) ? order.Customer.Address : "Chưa cập nhật địa chỉ giao hàng")
                        </p>
                        @if (!string.IsNullOrEmpty(order.Notes))
                        {
                            <div class="bg-light rounded-3 p-2 border mt-2 small">
                                <strong>Ghi chú:</strong> @order.Notes
                            </div>
                        }
                    </div>

                    <!-- Hành động nhanh -->
                    <div class="col-md-12 col-lg-3 text-lg-end d-flex flex-row flex-lg-column justify-content-start gap-2">
                        <h6 class="text-secondary fw-bold text-uppercase mb-3 d-none d-lg-block" style="font-size: 12px; letter-spacing: 0.5px;">Quản lý</h6>
                        <a asp-controller="Orders" asp-action="Edit" asp-route-id="@order.Id" class="btn btn-warning rounded-pill px-4 text-dark w-100 d-inline-flex align-items-center justify-content-center gap-1" style="font-weight: 500;">
                            <i class="bi bi-pencil-square"></i> Cập nhật trạng thái
                        </a>
                        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 w-100 d-inline-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-arrow-left-circle"></i> Trở về danh sách
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Bảng danh sách chi tiết sản phẩm trong hóa đơn -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-light border-0 py-3 px-4">
            <h5 class="fw-bold text-dark mb-0"><i class="bi bi-cart4 text-primary"></i> DANH SÁCH MẶT HÀNG ĐÃ ĐẶT</h5>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 12px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px;">STT</th>
                            <th class="py-3" style="width: 100px; text-align: center;">Hình ảnh</th>
                            <th class="py-3">Tên sản phẩm</th>
                            <th class="py-3 text-center" style="width: 120px;">Số lượng</th>
                            <th class="py-3 text-end" style="width: 160px;">Đơn giá</th>
                            <th class="pe-4 py-3 text-end" style="width: 180px;">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            decimal grandTotal = 0;
                            
                            foreach (var item in Model)
                            {
                                decimal itemTotal = item.Quantity * item.UnitPrice;
                                grandTotal += itemTotal;
                                
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@index</td>
                                    <td>
                                        <div class="d-flex align-items-center justify-content-center bg-light rounded-3 overflow-hidden border mx-auto" style="width: 60px; height: 60px;">
                                            @if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                                            {
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image text-secondary fs-4"></i>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.Product != null)
                                        {
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Product.Name</span>
                                                <span class="text-muted small">Mã sản phẩm: #@item.Product.Id</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Mã SP: #@item.ProductId (Sản phẩm đã bị xóa hoặc ẩn)</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold text-dark">
                                        @item.Quantity chiếc
                                    </td>
                                    <td class="text-end fw-semibold text-dark">
                                        @item.UnitPrice.ToString("N0") đ
                                    </td>
                                    <td class="pe-4 text-end fw-bold text-danger">
                                        @itemTotal.ToString("N0") đ
                                    </td>
                                </tr>
                                index++;
                            }
                            
                            <!-- Tổng thanh toán -->
                            <tr class="table-light">
                                <td colspan="4" class="text-end fw-bold py-3 text-uppercase" style="font-size: 13px;">Tổng cộng thanh toán:</td>
                                <td colspan="2" class="pe-4 text-end py-3 fw-bold text-danger fs-5">
                                    @grandTotal.ToString("N0") đ
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-basket fs-1 d-block mb-3 text-secondary"></i>
                                    Không có dữ liệu chi tiết mặt hàng cho đơn đặt hàng này.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Chân trang hiển thị thông tin tác giả -->
        <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
            Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
        </div>
    </div>
</div>
