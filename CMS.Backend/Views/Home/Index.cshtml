@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Trang chủ";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 15/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu truyền từ controller sang giao diện là danh sách 3 bài viết mới nhất *@
@model IEnumerable<CMS.Data.Entities.Post>

<!-- Phần biểu ngữ chào mừng lớn đầu trang chủ -->
<div class="p-5 mb-4 bg-light rounded-3 text-center border shadow-sm">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold text-primary">TRANG QUẢN TRỊ</h1>
        <p class="col-md-12 fs-5 text-muted">Dự án được xây dựng bởi sinh viên Vũ Hoàng Chính - Lớp CCQ2211J</p>
        <div class="d-flex justify-content-center gap-2 mt-3">
            <a href="/Post" class="btn btn-primary btn-md px-4">Quản lý bài viết</a>
            <a href="/Category" class="btn btn-outline-secondary btn-md px-4">Quản lý danh mục</a>
        </div>
    </div>
</div>

<div class="container my-5">
    <!-- Tiêu đề phần tin tức mới nhất -->
    <h2 class="text-center mb-4 text-danger fw-bold">TIN TỨC MỚI NHẤT</h2>
    
    <!-- Lưới hiển thị các thẻ bài viết -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            // Duyệt qua danh sách bài viết mới nhất được truyền sang
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <!-- Thẻ bài viết thiết lập chiều cao 100% để hiển thị đồng đều -->
                    <div class="card shadow-sm h-100 border">
                        <!-- Hình ảnh minh họa bài viết thiết lập kích thước hợp lý -->
                        <img src="@item.ImageUrl" class="card-img-top" alt="Hình ảnh bài viết" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <!-- Nhãn tên danh mục của bài viết, hiển thị màu xanh lam nổi bật -->
                            @if (item.Category != null)
                            {
                                <span class="badge bg-primary mb-2 align-self-start">@item.Category.Name</span>
                            }
                            
                            <!-- Tiêu đề của bài viết -->
                            <h5 class="card-title fw-bold text-dark">@item.Title</h5>
                            
                            <!-- Tóm tắt nội dung bài viết, tự động cắt ngắn nếu nội dung quá dài -->
                            <p class="card-text text-truncate flex-grow-1 text-muted"> 
                            @System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty)
                            </p>
                            
                            <!-- Nút chuyển tới trang xem chi tiết bài viết -->
                            <a href="@Url.Action("Details", "Post", new { id = item.Id })" class="btn btn-outline-danger btn-sm w-100 mt-3">
                                Đọc tiếp
                            </a>
                        </div>
                        
                        <!-- Chân của thẻ bài viết hiển thị ngày tháng năm đăng bài viết -->
                        <div class="card-footer text-muted small bg-white border-0 py-3">
                            Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Thông báo hiển thị nếu cơ sở dữ liệu chưa có bài viết nào -->
            <div class="col-12 text-center text-muted py-5 border rounded bg-white shadow-sm">
                Hiện tại chưa có bài viết tin tức nào được đăng tải trên hệ thống.
            </div>
        }
    </div>
</div>
