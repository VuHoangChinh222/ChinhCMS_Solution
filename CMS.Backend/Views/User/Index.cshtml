@model IEnumerable<CMS.Data.Entities.User>

@{
    ViewData["Title"] = "Quản lý Thành viên";
    Layout = "_LayoutAdmin";
    
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.2
 */ *@

<div class="container-fluid mt-4">
    <!-- Hiển thị thông báo lỗi hệ thống nếu có (VD: Admin cố tự xóa chính mình) -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-shield-exclamation fs-3 me-3 text-danger"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1">Thao tác bị từ chối!</h6>
                <p class="mb-0 small">@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Tiêu đề & Nút thêm mới -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">QUẢN LÝ THÀNH VIÊN HỆ THỐNG</h3>
                <p class="text-muted small mb-0">Quản trị các tài khoản nhân viên, cộng tác viên vận hành hệ thống ChinhCMS.</p>
            </div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                <i class="bi bi-person-plus-fill"></i> Thêm thành viên mới
            </a>
        </div>
    </div>

    <!-- Bảng danh sách thành viên -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 12px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3" style="width: 100px;">ID</th>
                            <th class="py-3">Tên đăng nhập</th>
                            <th class="py-3">Họ và tên</th>
                            <th class="py-3" style="width: 180px;">Quyền hạn</th>
                            <th class="pe-4 py-3 text-end" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-3 text-secondary"></i>
                                    Chưa có tài khoản quản trị nào trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var user in Model)
                            {
                                // Kiểm tra xem user này có phải là chính tài khoản Admin đang đăng nhập không
                                bool isCurrentUser = (user.Username == User.Identity.Name);
                                
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@user.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="p-2 rounded bg-light text-secondary">
                                                <i class="bi bi-shield-lock-fill"></i>
                                            </span>
                                            <span class="fw-bold text-dark">@user.Username</span>
                                            @if (isCurrentUser)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill fw-bold small">
                                                    <i class="bi bi-person-check-fill me-1"></i> Bạn
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>@user.FullName</td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-star-fill text-danger me-1"></i> Admin
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-person-fill text-info me-1"></i> Staff
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            @if (isCurrentUser)
                                            {
                                                <!-- NÚT XÓA BỊ VÔ HIỆU HÓA: Không cho phép Admin xóa chính mình -->
                                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1 disabled" style="opacity: 0.5; cursor: not-allowed;" title="Bạn không thể xóa chính tài khoản đang đăng nhập">
                                                    <i class="bi bi-trash3-fill"></i> Xóa
                                                </button>
                                            }
                                            else
                                            {
                                                <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1"
                                                   onclick="return confirm('Bạn có chắc chắn muốn xóa thành viên @user.Username không?')">
                                                    <i class="bi bi-trash3-fill"></i> Xóa
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        
        <!-- Chân trang & Phân trang -->
        <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
            <div class="text-muted small">
                Hiển thị trang <strong>@currentPage</strong> trên tổng số <strong>@totalPages</strong> trang (Tổng cộng <strong>@totalItems</strong> tài khoản)
            </div>
            
            <nav aria-label="Điều hướng phân trang">
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-start-pill px-3" href="?page=@(currentPage - 1)">Trước</a>
                    </li>
                    
                    @for (int i = 1; i <= Math.Max(1, totalPages); i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link px-3" href="?page=@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-end-pill px-3" href="?page=@(currentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
        
        <!-- Chân trang hiển thị thông tin tác giả -->
        <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
            Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
        </div>
    </div>
</div>