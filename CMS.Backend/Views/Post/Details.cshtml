@*
    Thư mục chứa giao diện chi tiết của một bài viết
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt bằng tiêu đề bài viết
    ViewData["Title"] = Model?.Title ?? "Chi tiết bài viết";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 15/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu truyền từ controller sang giao diện là một đối tượng bài viết duy nhất *@
@model CMS.Data.Entities.Post

<div class="container mt-5">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Post">Danh sách bài viết</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết bài viết</li>
        </ol>
    </nav>

    @if (Model != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-10">
                <!-- Tiêu đề lớn của bài viết -->
                <h1 class="display-4 fw-bold text-primary">@Model.Title</h1>
                
                <!-- Khu vực hiển thị ngày đăng và danh mục bài viết -->
                <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                    <span class="text-muted">Đăng ngày: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</span>
                    
                    <!-- Hiển thị nhãn tên danh mục, được lấy từ thuộc tính liên kết bảng Category -->
                    @if (Model.Category != null)
                    {
                        <span class="badge bg-info text-dark">Chuyên mục: @Model.Category.Name</span>
                    }
                </div>
                <hr />

                <!-- Hình ảnh lớn đại diện của bài viết -->
                <div class="text-center mb-4">
                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow" alt="Hình ảnh bài viết" style="width: 100%; max-height: 500px; object-fit: cover;">
                </div>

                <!-- Phần hiển thị nội dung đầy đủ của bài viết -->
                <div class="post-content fs-5 lh-lg">
                    @* 
                       Sử dụng @Html.Raw để hiển thị nội dung bài viết có định dạng HTML 
                       do người dùng soạn thảo từ trình biên tập giàu tính năng CKEditor 5,
                       tránh việc hiển thị thô các thẻ HTML như <p>, <strong> ra trình duyệt.
                    *@
                    @Html.Raw(Model.Content)
                </div>

                <!-- Nút quay lại danh sách bài viết -->
                <div class="mt-5 border-top pt-3 text-end">
                    <a href="/Post" class="btn btn-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Hiển thị thông báo nếu không có dữ liệu bài viết -->
        <div class="alert alert-danger text-center">
            Không tìm thấy thông tin bài viết này trong hệ thống.
        </div>
    }
</div>

<style>
    /* Styling cho bảng tạo từ CKEditor 5 */
    .post-content table {
        width: 100% !important;
        margin: 1.5rem 0;
        border-collapse: collapse;
        border: 1px solid #dee2e6;
    }
    .post-content table th, 
    .post-content table td {
        padding: 0.75rem;
        border: 1px solid #dee2e6;
        vertical-align: middle;
    }
    .post-content table th {
        background-color: #f8f9fa;
        font-weight: bold;
    }
    .post-content figure.table {
        margin: 1.5rem 0;
        width: 100%;
        overflow-x: auto;
    }
    /* Styling cho khung nhúng video */
    .post-content figure.media {
        margin: 1.5rem auto;
        max-width: 100%;
        display: flex;
        justify-content: center;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var container = document.querySelector('.post-content');
        if (!container) return;

        // Chuyển đổi thẻ oembed của CKEditor 5 thành iframe phát được video
        var oembeds = container.querySelectorAll('oembed');
        oembeds.forEach(function (oembed) {
            var url = oembed.getAttribute('url');
            if (url) {
                var embedUrl = '';
                
                // Trích xuất ID youtube
                var ytRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
                var ytMatch = url.match(ytRegex);
                if (ytMatch && ytMatch[1]) {
                    embedUrl = 'https://www.youtube.com/embed/' + ytMatch[1];
                }

                // Trích xuất ID vimeo
                var vimeoRegex = /vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/(?:[^\/]+)\/videos\/|album\/(?:\d+)\/video\/|video\/|)(\d+)(?:$|\/|\?)/i;
                var vimeoMatch = url.match(vimeoRegex);
                if (vimeoMatch && vimeoMatch[1]) {
                    embedUrl = 'https://player.vimeo.com/video/' + vimeoMatch[1];
                }

                if (embedUrl) {
                    var iframe = document.createElement('iframe');
                    iframe.src = embedUrl;
                    iframe.width = "100%";
                    iframe.height = "480";
                    iframe.setAttribute('frameborder', '0');
                    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
                    iframe.setAttribute('allowfullscreen', 'true');
                    iframe.style.borderRadius = "8px";
                    iframe.style.marginTop = "10px";
                    iframe.style.marginBottom = "10px";
                    iframe.style.boxShadow = "0 4px 15px rgba(0,0,0,0.1)";
                    
                    // Thay thế thẻ oembed bằng iframe
                    if (oembed.parentNode) {
                        oembed.parentNode.replaceChild(iframe, oembed);
                    }
                }
            }
        });
    });
</script>
