@model IEnumerable<CMS.Data.Entities.Post>


<div class="container mt-4">
    <h2 class="mb-4 text-info">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
    <div class="row">
        @foreach(var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Thumbnail" sizes="25%">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.Title</h5>
                        <p class="card-text text-truncate">@item.Content</p>
                        <p class="text-muted small">Ngày đăng: @item.CreatedDate.ToString("dd/mm/yyyy")</p>
                        <a href="@Url.Action("Details", "Post", new { id = item.Id })" class="btn btn-primary">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>