@*
    Thư mục chứa giao diện danh sách bài viết
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Danh sách bài viết";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 15/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu truyền từ controller sang giao diện là một danh sách các bài viết *@
@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <!-- Tiêu đề trang danh sách bài viết -->
    <h2 class="mb-4 text-info">DANH SÁCH BÀI VIẾT MỚI NHẤT</h2>
    
    <!-- Lưới hiển thị các thẻ bài viết -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            // Duyệt qua từng bài viết trong danh sách được truyền sang
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-3">
                    <!-- Thẻ hiển thị thông tin tóm tắt của một bài viết -->
                    <div class="card shadow-sm h-100">
                        <!-- Hình ảnh minh họa của bài viết -->
                        <img src="@item.ImageUrl" class="card-img-top" alt="Hình ảnh minh họa" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <!-- Nhãn hiển thị tên danh mục của bài viết, được lấy thông qua liên kết bảng -->
                            @if (item.Category != null)
                            {
                                <span class="badge bg-info text-dark mb-2 align-self-start">@item.Category.Name</span>
                            }
                            
                            <!-- Tiêu đề của bài viết -->
                            <h5 class="card-title text-primary">@item.Title</h5>
                            
                            <!-- Tóm tắt nội dung bài viết, tự động cắt ngắn nếu nội dung quá dài -->
                            <p class="card-text text-truncate flex-grow-1">@item.Content</p>
                            
                            <!-- Định dạng hiển thị ngày đăng bài viết chính xác theo định dạng ngày/tháng/năm -->
                            <p class="text-muted small mt-auto">Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")</p>
                            
                            <!-- Nút chuyển đến trang hiển thị chi tiết của bài viết tương ứng -->
                            <a href="@Url.Action("Details", "Post", new { id = item.Id })" class="btn btn-primary btn-sm w-100 mt-2">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Hiển thị thông báo nếu danh sách bài viết trống -->
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    Không có bài viết nào được tìm thấy trong hệ thống hoặc danh mục này chưa có bài viết.
                </div>
            </div>
        }
    </div>
</div>