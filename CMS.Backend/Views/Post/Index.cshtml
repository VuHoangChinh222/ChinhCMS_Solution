@*
    Thư mục chứa giao diện danh sách bài viết quản trị
*@
@{
    // Thiết lập tiêu đề trang hiển thị trên thẻ trình duyệt
    ViewData["Title"] = "Quản lý bài viết";
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 15/05/2026
   Phiên bản: 1.0
*@

@* Khai báo kiểu dữ liệu truyền từ controller sang giao diện là một danh sách các bài viết *@
@model IEnumerable<CMS.Data.Entities.Post>

<div class="container mt-4">
    <!-- Tiêu đề trang và nút Thêm mới bài viết được xếp hàng ngang cân đối bằng flexbox -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-dark fw-bold mb-0">DANH SÁCH BÀI VIẾT QUẢN TRỊ</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Thêm bài viết mới
        </a>
    </div>
    
    <!-- Lưới hiển thị các thẻ bài viết -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            // Duyệt qua từng bài viết trong danh sách được truyền sang để tạo card
            foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <!-- Thẻ hiển thị thông tin tóm tắt của một bài viết có chiều cao full và viền nhẹ -->
                    <div class="card shadow-sm h-100 border">
                        <!-- Hình ảnh minh họa của bài viết, tự động ôm khít khung -->
                        <img src="@item.ImageUrl" class="card-img-top" alt="Hình ảnh minh họa" style="height: 200px; object-fit: cover;">
                        
                        <div class="card-body d-flex flex-column">
                            <!-- Nhãn hiển thị tên danh mục của bài viết, được lấy thông qua liên kết bảng -->
                            @if (item.Category != null)
                            {
                                <span class="badge bg-info text-dark mb-2 align-self-start">@item.Category.Name</span>
                            }
                            
                            <!-- Tiêu đề của bài viết -->
                            <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                            
                            <!-- Tóm tắt nội dung bài viết, loại bỏ các thẻ HTML để hiển thị văn bản thuần túy tóm tắt sạch sẽ -->
                            <p class="card-text text-truncate flex-grow-1 text-muted">
                                @* 
                                   Sử dụng biểu thức chính quy Regex để tìm và thay thế toàn bộ các thẻ HTML (ví dụ <p>, <strong>)
                                   thành chuỗi rỗng, giúp hiển thị văn bản thô tóm tắt mà không bị lẫn mã HTML hay làm vỡ giao diện thẻ.
                                *@
                                @System.Text.RegularExpressions.Regex.Replace(item.Content ?? "", "<.*?>", string.Empty)
                            </p>
                            
                            <!-- Định dạng hiển thị ngày đăng bài viết chính xác theo định dạng ngày/tháng/năm -->
                            <p class="text-muted small mt-2 mb-0">
                                <i class="bi bi-calendar3"></i> Ngày đăng: @item.CreatedDate.ToString("dd/MM/yyyy")
                            </p>
                            
                            <!-- Hàng nút thao tác hành động quản lý bài viết -->
                            <div class="d-flex justify-content-between gap-1 mt-3">
                                <!-- Nút xem chi tiết -->
                                <a href="@Url.Action("Details", "Post", new { id = item.Id })" class="btn btn-sm btn-outline-primary flex-grow-1">
                                    Chi tiết
                                </a>
                                <!-- Nút chỉnh sửa -->
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                    Sửa
                                </a>
                                <!-- Nút xóa có bảng hỏi xác nhận bảo vệ dữ liệu -->
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Bạn có chắc chắn muốn xóa bài viết này không?')">
                                    Xóa
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <!-- Hiển thị thông báo nếu danh sách bài viết trống -->
            <div class="col-12 text-center text-muted py-5 border rounded bg-white shadow-sm">
                Hiện tại chưa có bài viết nào được đăng tải trên hệ thống hoặc danh mục này trống.
            </div>
        }
    </div>
</div>