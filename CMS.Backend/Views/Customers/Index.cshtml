@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Quản lý Khách Hàng";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Hộp thông báo lỗi nếu có -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong>Lỗi hệ thống:</strong> @TempData["ErrorMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tiêu đề & Nút thêm mới -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">QUẢN LÝ KHÁCH HÀNG</h3>
                <p class="text-muted small mb-0">Theo dõi thông tin liên lạc, danh sách tài khoản mua sắm và đơn hàng của khách hàng</p>
            </div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                <i class="bi bi-person-plus-fill"></i> Thêm khách hàng mới
            </a>
        </div>
    </div>

    <!-- Bảng danh sách khách hàng -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 900px;">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 12px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px;">ID</th>
                            <th class="py-3">Họ và tên</th>
                            <th class="py-3">Liên lạc Email</th>
                            <th class="py-3">Số điện thoại</th>
                            <th class="py-3">Địa chỉ giao hàng</th>
                            <th class="py-3 text-center" style="width: 150px;">Đơn hàng</th>
                            <th class="pe-4 py-3 text-end" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-3 text-secondary"></i>
                                    Chưa có khách hàng nào trong hệ thống.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                int orderCount = item.Orders != null ? item.Orders.Count : 0;
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">#@item.Id</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="p-2 rounded bg-indigo bg-opacity-10 text-indigo" style="color: #4f46e5; background-color: rgba(79, 70, 229, 0.1);">
                                                <i class="bi bi-person-fill"></i>
                                            </span>
                                            <span class="fw-bold text-dark">@item.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Email" class="text-decoration-none d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-envelope"></i> @item.Email
                                        </a>
                                    </td>
                                    <td class="text-muted">
                                        @(item.Phone ?? "Chưa cập nhật")
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 250px;">
                                        @(item.Address ?? "Chưa cập nhật")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(orderCount > 0 ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-3 py-2 fw-bold" style="font-size: 13px;">
                                            @orderCount đơn hàng
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-trash3-fill"></i> Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Chân trang & Phân trang -->
        @{
            int currentPage = ViewBag.CurrentPage ?? 1;
            int totalPages = ViewBag.TotalPages ?? 1;
            int totalItems = ViewBag.TotalItems ?? 0;
        }
        <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
            <div class="text-muted small">
                Hiển thị trang <strong>@currentPage</strong> trên tổng số <strong>@totalPages</strong> trang (Tổng cộng <strong>@totalItems</strong> khách hàng)
            </div>
            
            <nav aria-label="Điều hướng phân trang">
                <ul class="pagination pagination-sm mb-0 justify-content-center">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-start-pill px-3" href="?page=@(currentPage - 1)">Trước</a>
                    </li>
                    
                    @for (int i = 1; i <= Math.Max(1, totalPages); i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link px-3" href="?page=@i">@i</a>
                        </li>
                    }
                    
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-end-pill px-3" href="?page=@(currentPage + 1)">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
        <!-- Chân trang hiển thị thông tin tác giả -->
        <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
            Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
        </div>
    </div>
</div>