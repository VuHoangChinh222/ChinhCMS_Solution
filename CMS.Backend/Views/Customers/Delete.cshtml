@model CMS.Data.Entities.Customer

@{
    ViewData["Title"] = "Xác Nhận Xóa Khách Hàng";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 26/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-people-fill"></i> Quản lý khách hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa khách hàng</li>
        </ol>
    </nav>

    @{
        int orderCount = Model.Orders != null ? Model.Orders.Count : 0;
        int activeOrdersCount = Model.Orders != null ? Model.Orders.Count(o => o.Status == 0 || o.Status == 1) : 0;
        int historyOrdersCount = Model.Orders != null ? Model.Orders.Count(o => o.Status == 2 || o.Status == 3) : 0;
        bool hasActiveOrders = activeOrdersCount > 0;
    }

    @if (hasActiveOrders)
    {
        <!-- Cảnh báo nghiêm trọng: Có đơn hàng đang giao dịch (Chờ duyệt hoặc Đang giao hàng) -> KHÓA XÓA -->
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-shield-slash-fill fs-3 me-3 text-danger"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">CẢNH BÁO BẢO VỆ GIAO DỊCH: KHÔNG THỂ XÓA!</h5>
                <p class="mb-0 small">
                    Khách hàng <strong>@Model.FullName</strong> hiện đang có <strong>@activeOrdersCount đơn hàng hoạt động</strong> (ở trạng thái <strong>Chờ duyệt</strong> hoặc <strong>Đang giao hàng</strong>). 
                    Hệ thống **không cho phép xóa** khách hàng này để tránh gián đoạn các giao dịch đang diễn ra.
                </p>
            </div>
        </div>
    }
    else if (historyOrdersCount > 0)
    {
        <!-- Cảnh báo thông thường: Chỉ có đơn hàng cũ (Đã hoàn thành hoặc Đã hủy) -> CHO PHÉP XÓA nhưng cảnh báo xóa kèm dữ liệu -->
        <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-warning"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">CẢNH BÁO: XÓA DỮ LIỆU LỊCH SỬ!</h5>
                <p class="mb-0 small">
                    Khách hàng này chỉ có <strong>@historyOrdersCount đơn hàng cũ</strong> (đã ở trạng thái <strong>Đã xong</strong> hoặc <strong>Đã hủy</strong>). 
                    Khi bạn thực hiện hành động này, toàn bộ dữ liệu đơn hàng và chi tiết đơn hàng cũ của họ cũng sẽ bị **xóa vĩnh viễn** khỏi cơ sở dữ liệu.
                </p>
            </div>
        </div>
    }
    else
    {
        <!-- Khách hàng mới hoàn toàn, chưa mua sắm bao giờ -> CHO PHÉP XÓA thoải mái -->
        <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-3 me-3 text-info"></i>
            <div>
                <h5 class="alert-heading fw-bold mb-1">XÁC NHẬN HÀNH ĐỘNG XÓA</h5>
                <p class="mb-0 small">Khách hàng này chưa thực hiện bất kỳ giao dịch mua sắm nào. Tài khoản sẽ bị xóa hoàn toàn khỏi hệ thống.</p>
            </div>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-trash3-fill"></i>
                        </span>
                        CHI TIẾT TÀI KHOẢN KHÁCH HÀNG
                    </h4>
                    <hr class="mt-3 mb-0 border-light" />
                </div>
                
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center mb-3 mb-md-0 border-end border-light">
                            <span class="p-4 rounded-circle bg-light text-secondary d-inline-flex justify-content-center align-items-center" style="width: 100px; height: 100px; font-size: 3rem;">
                                <i class="bi bi-person-fill"></i>
                            </span>
                        </div>

                        <div class="col-md-9 ps-md-4">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 fw-bold text-muted mb-2">Mã khách hàng:</dt>
                                <dd class="col-sm-8 mb-2 text-dark">#@Model.Id</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Họ và tên khách hàng:</dt>
                                <dd class="col-sm-8 mb-2 fw-bold text-dark">@Model.FullName</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Địa chỉ Email:</dt>
                                <dd class="col-sm-8 mb-2 text-primary">@Model.Email</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Số điện thoại:</dt>
                                <dd class="col-sm-8 mb-2 text-dark">@(Model.Phone ?? "Chưa cập nhật")</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Địa chỉ giao hàng:</dt>
                                <dd class="col-sm-8 mb-2 text-muted small">@(Model.Address ?? "Chưa cập nhật")</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-0">Số đơn hàng liên kết:</dt>
                                <dd class="col-sm-8 mb-0 fw-bold">
                                    <span class="text-dark">Tổng số: @orderCount đơn hàng</span>
                                    <span class="d-block small text-muted">
                                        (Đang giao dịch: <strong class="text-danger">@activeOrdersCount</strong> | Đã xong/Hủy: <strong class="text-success">@historyOrdersCount</strong>)
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Chân trang chứa form xác nhận xóa -->
                <div class="card-footer bg-white border-0 py-4 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
                    <span class="text-muted small">Kiểm tra kỹ lưỡng trạng thái các đơn hàng trước khi xóa.</span>
                    
                    <form asp-action="Delete" method="post" class="m-0">
                        <!-- Lưu lại Id khách hàng -->
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ & Quay lại
                            </a>
                            
                            @if (hasActiveOrders)
                            {
                                <button type="button" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1 disabled" style="opacity: 0.65; cursor: not-allowed;" title="Khách hàng đang có đơn hàng chờ duyệt hoặc đang giao, không thể xóa">
                                    <i class="bi bi-trash3-fill"></i> Đã bị Khóa xóa
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
                                    <i class="bi bi-trash3-fill"></i> Xác nhận xóa tài khoản
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
