@{
    Layout = null; // Trang đăng nhập độc lập, không dùng chung LayoutAdmin
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập hệ thống - ChinhCMS</title>
    
    <!-- Google Fonts (Outfit) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary-grad: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            --bg-grad: radial-gradient(circle at 10% 20%, rgba(216, 241, 230, 0.46) 0.1%, rgba(233, 226, 226, 0.28) 90.1%);
        }
        
        body {
            font-family: 'Outfit', sans-serif;
            background: var(--bg-grad), #f3f4f6;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        /* Trang trí background hình tròn lung linh */
        .bubble {
            position: absolute;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(79, 70, 229, 0.15) 0%, rgba(124, 58, 237, 0.15) 100%);
            z-index: 1;
            filter: blur(40px);
        }
        .bubble-1 { width: 300px; height: 300px; top: -100px; left: -100px; }
        .bubble-2 { width: 400px; height: 400px; bottom: -150px; right: -100px; }

        .login-container {
            z-index: 10;
            width: 100%;
            max-width: 420px;
            padding: 15px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
        }

        .card-header-custom {
            background: var(--primary-grad);
            border-radius: 20px 20px 0 0 !important;
            padding: 30px 20px;
            text-align: center;
            color: #ffffff;
            position: relative;
        }

        .brand-logo {
            width: 55px;
            height: 55px;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(5px);
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 12px;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

        .form-control-custom {
            background: rgba(243, 244, 246, 0.7);
            border: 1px solid rgba(209, 213, 219, 0.6);
            border-radius: 10px;
            padding: 12px 15px 12px 42px;
            font-size: 15px;
            transition: all 0.25s ease;
        }

        .form-control-custom:focus {
            background: #ffffff;
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
            outline: none;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group-custom i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6b7280;
            font-size: 16px;
            z-index: 10;
            transition: color 0.25s ease;
        }

        .form-control-custom:focus + i {
            color: #7c3aed;
        }

        .btn-login {
            background: var(--primary-grad);
            border: none;
            border-radius: 10px;
            padding: 12px;
            color: white;
            font-weight: 600;
            font-size: 16px;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            box-shadow: 0 5px 15px rgba(124, 58, 237, 0.3);
        }

        .btn-login:hover {
            opacity: 0.95;
            box-shadow: 0 8px 20px rgba(124, 58, 237, 0.4);
            transform: translateY(-1px);
        }

        .btn-login:active {
            transform: translateY(1px);
        }

        .copyright-text {
            font-size: 12px;
            color: #9ca3af;
            text-align: center;
            margin-top: 25px;
        }
    </style>
</head>
<body>

    <!-- Bubbles background -->
    <div class="bubble bubble-1"></div>
    <div class="bubble bubble-2"></div>

    <div class="login-container">
        <div class="login-card border-0">
            <!-- Card Header -->
            <div class="card-header-custom border-0">
                @* <div class="brand-logo">
                    <i class="bi bi-shield-lock-fill"></i>
                </div> *@
                <h4 class="mb-1 fw-bold">ChinhCMS</h4>
            </div>
            
            <!-- Card Body -->
            <div class="card-body p-4">
                <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center py-2 px-3 border-0 rounded-3 mb-4 shadow-sm" role="alert" style="background: rgba(254, 226, 226, 0.9);">
                            <i class="bi bi-exclamation-triangle-fill text-danger me-2 fs-5"></i>
                            <div class="small fw-medium text-danger">@ViewBag.Error</div>
                        </div>
                    }

                    <!-- Username field -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">Tên đăng nhập</label>
                        <div class="input-group-custom">
                            <input type="text" name="username" class="form-control form-control-custom" placeholder="Nhập tài khoản" required />
                            <i class="bi bi-person-fill"></i>
                        </div>
                    </div>

                    <!-- Password field -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark mb-1">Mật khẩu</label>
                        <div class="input-group-custom">
                            <input type="password" name="password" class="form-control form-control-custom" placeholder="Nhập mật khẩu" required />
                            <i class="bi bi-key-fill"></i>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn btn-login w-100 mb-2">
                        <i class="bi bi-box-arrow-in-right me-2"></i>ĐĂNG NHẬP HỆ THỐNG
                    </button>
                </form>

                <div class="copyright-text">
                    <span>Sinh viên: Vũ Hoàng Chính - 2122110380</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
