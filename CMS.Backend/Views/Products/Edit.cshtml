@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Cập Nhật Sản Phẩm";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-box-seam"></i> Quản lý sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cập nhật sản phẩm</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-pencil-square"></i>
                        </span>
                        CẬP NHẬT THÔNG TIN SẢN PHẨM
                    </h3>
                    <p class="text-muted small mb-0">Chỉnh sửa thông số, giá cả hoặc cập nhật lại hình ảnh của sản phẩm.</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <!-- Biểu mẫu gửi dữ liệu với thuộc tính enctype để upload file ảnh -->
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <!-- Khu vực hiển thị thông báo lỗi tổng hợp -->
                        <!-- <div asp-validation-summary="All" class="text-danger mb-3"></div> -->

                        <!-- Trường ẩn để lưu giữ lại Id sản phẩm trong suốt quá trình cập nhật -->
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <!-- Cột bên trái: Thông tin cơ bản -->
                            <div class="col-md-7 border-end border-light pe-md-4">
                                <!-- Tên sản phẩm -->
                                <div class="mb-4">
                                    <label asp-for="Name" class="form-label fw-bold text-dark">Tên sản phẩm <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag-fill"></i></span>
                                        <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Ví dụ: Điện thoại iPhone 15 Pro..." style="background-color: #fff;" />
                                    </div>
                                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Đường dẫn thân thiện (Slug) -->
                                <div class="mb-4">
                                    <label asp-for="Slug" class="form-label fw-bold text-dark">Đường dẫn thân thiện (Slug)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-link-45deg"></i></span>
                                        <input asp-for="Slug" class="form-control border-start-0 ps-0" placeholder="Để trống hệ thống sẽ tự động tạo từ tên..." style="background-color: #fff;" />
                                    </div>
                                    <span asp-validation-for="Slug" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Chọn danh mục -->
                                <div class="mb-4">
                                    <label asp-for="CategoryProductId" class="form-label fw-bold text-dark">Danh mục sản phẩm <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-grid-fill"></i></span>
                                        <select asp-for="CategoryProductId" asp-items="ViewBag.CategoryProductList" class="form-select border-start-0 ps-0" style="background-color: #fff;">
                                            <option value="">-- Chọn danh mục sản phẩm --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CategoryProductId" class="text-danger small mt-1 d-block"></span>
                                </div>

                                <!-- Giá bán và Số lượng tồn kho (Chia làm 2 cột) -->
                                <div class="row">
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Price" class="form-label fw-bold text-dark">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-currency-dollar"></i></span>
                                            <input asp-for="Price" type="number" class="form-control border-start-0 ps-0" placeholder="Nhập giá bán..." style="background-color: #fff;" />
                                        </div>
                                        <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <label asp-for="StockQuantity" class="form-label fw-bold text-dark">Số lượng tồn kho <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-archive-fill"></i></span>
                                            <input asp-for="StockQuantity" type="number" class="form-control border-start-0 ps-0" placeholder="Số lượng..." style="background-color: #fff;" />
                                        </div>
                                        <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                                    </div>
                                </div>

                                <!-- Mô tả chi tiết -->
                                <div class="mb-4">
                                    <label asp-for="Description" class="form-label fw-bold text-dark">Mô tả sản phẩm</label>
                                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập cấu hình, đặc điểm nổi bật..."></textarea>
                                    <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Cột bên phải: Quản lý hình ảnh -->
                            <div class="col-md-5 ps-md-4">
                                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-image"></i> HÌNH ẢNH SẢN PHẨM</h5>
                                
                                <!-- Ảnh hiện tại (Preview) -->
                                <div class="mb-4 text-center">
                                    <label class="form-label fw-bold text-dark d-block text-start">Ảnh hiện tại</label>
                                    <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-3 overflow-hidden border p-2" style="width: 150px; height: 150px;">
                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover; border-radius: 5px;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-image text-secondary fs-1"></i>
                                        }
                                    </div>
                                </div>

                                <!-- Upload ảnh file mới -->
                                <div class="card bg-light border-dashed rounded-3 p-3 mb-4 text-center">
                                    <div class="card-body py-3">
                                        <i class="bi bi-cloud-arrow-up-fill fs-2 text-warning mb-1"></i>
                                        <h6 class="fw-bold text-dark small">Tải ảnh mới thay thế</h6>
                                        <input type="file" name="uploadImage" class="form-control form-control-sm mt-2" accept="image/*" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Các nút lưu/hủy -->
                        <div class="d-flex gap-2 justify-content-end mt-3 border-top pt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1 text-dark" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border: none; font-weight: 500;">
                                <i class="bi bi-check-circle-fill"></i> Cập nhật sản phẩm
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
