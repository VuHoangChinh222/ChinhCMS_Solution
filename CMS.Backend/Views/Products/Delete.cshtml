@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Xác Nhận Xóa Sản Phẩm";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-box-seam"></i> Quản lý sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <!-- Hộp cảnh báo màu đỏ nguy hiểm -->
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">CẢNH BÁO: XÓA SẢN PHẨM KHỎI HỆ THỐNG!</h5>
            <p class="mb-0 small">Hành động này sẽ xóa sản phẩm khỏi kho hàng vĩnh viễn và không thể khôi phục lại. Bạn có chắc chắn muốn thực hiện?</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-trash3-fill"></i>
                        </span>
                        XÁC NHẬN XÓA SẢN PHẨM
                    </h4>
                    <hr class="mt-3 mb-0 border-light" />
                </div>
                
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <!-- Ảnh sản phẩm bên trái -->
                        <div class="col-md-4 text-center mb-3 mb-md-0 border-end border-light">
                            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-3 overflow-hidden border p-2" style="width: 180px; height: 180px;">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Name" style="width: 100%; height: 100%; object-fit: cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-image text-secondary fs-1"></i>
                                }
                            </div>
                        </div>

                        <!-- Thông tin sản phẩm bên phải -->
                        <div class="col-md-8 ps-md-4">
                            <dl class="row mb-0">
                                <dt class="col-sm-4 fw-bold text-muted mb-2">Mã sản phẩm (ID):</dt>
                                <dd class="col-sm-8 mb-2 text-dark">#@Model.Id</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Tên sản phẩm:</dt>
                                <dd class="col-sm-8 mb-2 fw-bold text-dark">@Model.Name</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Danh mục:</dt>
                                <dd class="col-sm-8 mb-2">
                                    @if (Model.CategoryProduct != null)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1">@Model.CategoryProduct.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Không rõ danh mục</span>
                                    }
                                </dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Giá bán niêm yết:</dt>
                                <dd class="col-sm-8 mb-2 fw-bold text-danger">@Model.Price.ToString("N0") đ</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-2">Số lượng trong kho:</dt>
                                <dd class="col-sm-8 mb-2 text-dark fw-bold">@Model.StockQuantity chiếc</dd>

                                <dt class="col-sm-4 fw-bold text-muted mb-0">Mô tả ngắn gọn:</dt>
                                <dd class="col-sm-8 mb-0 text-muted small">@(Model.Description ?? "Chưa có mô tả cho sản phẩm này")</dd>
                            </dl>
                        </div>
                    </div>
                </div>

                <!-- Chân trang chứa form xác nhận xóa -->
                <div class="card-footer bg-white border-0 py-4 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
                    <span class="text-muted small">Kiểm tra thông số kỹ thuật và số lượng tồn kho trước khi xóa.</span>
                    
                    <form asp-action="Delete" method="post" class="m-0">
                        <!-- Lưu lại Id sản phẩm để xóa -->
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ & Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
                                <i class="bi bi-trash3-fill"></i> Xác nhận xóa sản phẩm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
