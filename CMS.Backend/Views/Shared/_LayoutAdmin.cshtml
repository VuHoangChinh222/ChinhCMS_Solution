@*
    Razor Layout chung dành riêng cho khu vực quản trị hệ thống (Admin Panel)
    Hỗ trợ tương thích hiển thị (Responsive) trên mọi kích thước màn hình
*@
@{
    // Truy vấn dữ liệu định tuyến để xác định Controller và Action hiện tại nhằm tự động làm nổi bật menu tương ứng
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

@* 
   Thông tin sinh viên thực hiện dự án:
   Sinh viên : Vũ Hoàng Chính
   Mã sinh viên: 2122110380
   Lớp: CCQ2211J
   Ngày tạo: 21/05/2026
   Phiên bản: 1.0
*@

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChinhCMS Admin</title>
    <!-- Nạp thư viện Bootstrap gốc từ dự án -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Nạp thư viện biểu tượng Bootstrap Icons CDN phục vụ thiết kế Sidebar -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        /* Phong cách thanh Sidebar Admin tối màu sang trọng */
        .admin-sidebar { 
            width: 240px;
            min-height: 100vh;
            background-color: #212529; 
            color: #ffffff; 
            box-shadow: 2px 0 5px rgba(0,0,0,0.15);
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1030;
            overflow-y: auto;
        }

        /* Tiêu đề thương hiệu quản trị trên đầu thanh Sidebar */
        .admin-sidebar .brand-title {
            padding: 20px;
            font-size: 1.25rem;
            font-weight: bold;
            letter-spacing: 1px;
            border-bottom: 1px solid #2d3034;
            text-transform: uppercase;
        }

        /* Tiêu đề nhóm chức năng bên trong thanh Sidebar */
        .admin-sidebar .menu-section-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #6c757d;
            padding: 15px 20px 5px 20px;
            font-weight: bold;
        }

        /* Định dạng từng mục liên kết trên thanh Sidebar */
        .admin-sidebar a.nav-link-item { 
            color: #adb5bd; 
            text-decoration: none; 
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 20px; 
            transition: all 0.2s ease-in-out;
        }

        /* Hiệu ứng khi di chuột qua liên kết */
        .admin-sidebar a.nav-link-item:hover { 
            background-color: #2c3034; 
            color: #ffffff; 
        }

        /* Tô sáng mục menu đang được truy cập hiện tại */
        .admin-sidebar a.nav-link-item.active { 
            background-color: #0d6efd; 
            color: #ffffff !important; 
            font-weight: bold;
        }

        /* Vùng nội dung chính đẩy sang bên phải để tránh bị che bởi Sidebar trên màn hình lớn */
        .admin-main {
            margin-left: 240px;
            background-color: #f8f9fa;
            min-height: 100vh;
            padding: 24px;
        }

        /* Thanh tiêu đề dành cho màn hình điện thoại - mặc định ẩn */
        .admin-mobile-header {
            display: none;
        }

        /* Quy tắc hiển thị trên màn hình nhỏ hơn 768px (điện thoại di động, máy tính bảng nhỏ) */
        @@media (max-width: 767.98px) {
            /* Ẩn thanh Sidebar cố định trên di động (sử dụng Offcanvas Bootstrap thay thế) */
            .admin-sidebar {
                display: none !important;
            }

            /* Hiển thị thanh tiêu đề di động có nút 3 gạch ngang */
            .admin-mobile-header {
                display: flex;
            }

            /* Nội dung chính chiếm toàn bộ chiều rộng trên di động */
            .admin-main {
                margin-left: 0;
                padding: 16px;
            }
        }
    </style>
</head>
<body>

    <!-- Thanh tiêu đề di động (Chỉ xuất hiện trên màn hình nhỏ dưới 768px) -->
    <header class="admin-mobile-header navbar navbar-dark bg-dark shadow-sm px-3 py-2 sticky-top border-bottom border-secondary">
        <span class="navbar-brand fw-bold text-primary fs-5 mb-0">ChinhCMS Admin</span>
        
        <!-- Nút 3 dấu gạch ngang kích hoạt mở Sidebar dạng Offcanvas -->
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
    </header>

    <!-- Sidebar Offcanvas dành riêng cho di động (tách biệt hoàn toàn khỏi Sidebar Desktop) -->
    <div class="offcanvas offcanvas-start bg-dark text-white" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel" style="width: 280px;">
        <!-- Tiêu đề trên cùng và nút đóng -->
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title text-primary fw-bold" id="mobileSidebarLabel">ChinhCMS Admin</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <!-- Nội dung menu di động - hoàn toàn giống menu trên Desktop -->
        <div class="offcanvas-body p-0">
            <a href="@Url.Action("Index", "Home")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Home" && currentAction == "Index" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-speedometer2"></i> Bảng điều khiển
            </a>
            <div class="px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold" style="letter-spacing:1px; font-size:0.75rem;">Nội dung tin tức</div>
            <a href="@Url.Action("Index", "Category")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Category" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-grid-3x3-gap"></i> Quản lý danh mục
            </a>
            <a href="@Url.Action("Index", "Post")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Post" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-file-earmark-post-fill"></i> Quản lý bài viết
            </a>
            <div class="px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold" style="letter-spacing:1px; font-size:0.75rem;">Kinh doanh</div>
            <a href="@Url.Action("Index", "CategoriesProducts")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "CategoriesProducts" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-tags"></i> Danh mục sản phẩm
            </a>
            <a href="@Url.Action("Index", "Products")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Products" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-box-seam"></i> Sản phẩm kho hàng
            </a>
            <a href="@Url.Action("Index", "Customers")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Customers" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-person-heart"></i> Khách hàng mua sắm
            </a>
            <a href="@Url.Action("Index", "Orders")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "Orders" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-receipt"></i> Đơn hàng tổng hợp
            </a>
            <a href="@Url.Action("Index", "OrderDetails")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "OrderDetails" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-list-check"></i> Đơn hàng chi tiết
            </a>
            <div class="px-3 pt-3 pb-1 text-uppercase small text-secondary fw-bold" style="letter-spacing:1px; font-size:0.75rem;">Nhân sự</div>
            <a href="@Url.Action("Index", "User")" class="nav-link-item d-flex align-items-center gap-2 px-3 py-2 text-decoration-none @(currentController == "User" ? "active bg-primary text-white fw-bold" : "text-light")">
                <i class="bi bi-people-fill"></i> Quản lý thành viên
            </a>
        </div>
    </div>

    <!-- Sidebar cố định dành cho màn hình máy tính lớn (Desktop) -->
    <nav class="admin-sidebar">
        <div class="brand-title text-center text-primary">
            ChinhCMS Admin
        </div>
        <div class="mt-2">
            <!-- Mục 1: Bảng điều khiển chung -->
            <a asp-controller="Home" asp-action="Index" class="nav-link-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i> Bảng điều khiển
            </a>
            
            <!-- Nhóm chức năng Quản lý nội dung (CMS) -->
            <div class="menu-section-title">Nội dung tin tức</div>
            
            <a asp-controller="Category" asp-action="Index" class="nav-link-item @(currentController == "Category" ? "active" : "")">
                <i class="bi bi-grid-3x3-gap"></i> Quản lý danh mục
            </a>
            <a asp-controller="Post" asp-action="Index" class="nav-link-item @(currentController == "Post" ? "active" : "")">
                <i class="bi bi-file-earmark-post-fill"></i> Quản lý bài viết
            </a>
            
            <!-- Nhóm chức năng Quản lý sản phẩm và đơn hàng (E-Commerce) -->
            <div class="menu-section-title">Kinh doanh</div>
            
            <a asp-controller="CategoriesProducts" asp-action="Index" class="nav-link-item @(currentController == "CategoriesProducts" ? "active" : "")">
                <i class="bi bi-tags"></i> Danh mục sản phẩm
            </a>
            <a asp-controller="Products" asp-action="Index" class="nav-link-item @(currentController == "Products" ? "active" : "")">
                <i class="bi bi-box-seam"></i> Sản phẩm kho hàng
            </a>
            <a asp-controller="Customers" asp-action="Index" class="nav-link-item @(currentController == "Customers" ? "active" : "")">
                <i class="bi bi-person-heart"></i> Khách hàng mua sắm
            </a>
            <a asp-controller="Orders" asp-action="Index" class="nav-link-item @(currentController == "Orders" ? "active" : "")">
                <i class="bi bi-receipt"></i> Đơn hàng tổng hợp
            </a>
            <a asp-controller="OrderDetails" asp-action="Index" class="nav-link-item @(currentController == "OrderDetails" ? "active" : "")">
                <i class="bi bi-list-check"></i> Đơn hàng chi tiết
            </a>
            <!-- Nhóm chức năng quảng lý nhân sự editer ...-->
            <div class="menu-section-title">Nhân sự</div>
            <a asp-controller="User" asp-action="Index" class="nav-link-item @(currentController == "User" ? "active" : "")">
                <i class="bi bi-people-fill"></i> Quản lý thành viên
            </a>
        </div>
    </nav>

    <!-- Vùng nội dung chính hiển thị động -->
    <div class="admin-main">
        @RenderBody()
    </div>

    <!-- Tải các thư viện Script cơ bản -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Cho phép các View nạp thêm script bổ sung ở phía dưới -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
