@model IEnumerable<CMS.Data.Entities.CategoryProduct>

@{
    ViewData["Title"] = "Quản Lý Danh Mục Sản Phẩm";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Hộp thông báo lỗi nếu có -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <strong>Lỗi hệ thống:</strong> @TempData["ErrorMessage"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tiêu đề & Nút thêm mới -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">DANH MỤC SẢN PHẨM</h3>
                <p class="text-muted small mb-0">Quản lý và phân loại các mặt hàng kinh doanh trong hệ thống</p>
            </div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-2" style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border: none;">
                <i class="bi bi-plus-circle-fill"></i> Thêm danh mục mới
            </a>
        </div>
    </div>

    <!-- Bảng danh sách danh mục -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="min-width: 800px;">
                    <thead class="table-light text-uppercase text-secondary" style="font-size: 12px; letter-spacing: 0.5px;">
                        <tr>
                            <th class="ps-4 py-3" style="width: 80px;">ID</th>
                            <th class="py-3" style="width: 120px;">Hình ảnh</th>
                            <th class="py-3">Tên danh mục</th>
                            <th class="py-3">Mô tả chi tiết</th>
                            <th class="py-3 text-center" style="width: 150px;">Số sản phẩm</th>
                            <th class="pe-4 py-3 text-end" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder-x fs-1 d-block mb-3 text-secondary"></i>
                                    Chưa có danh mục sản phẩm nào được tạo.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                int productCount = item.Products != null ? item.Products.Count : 0;
                                <tr>
                                    <td class="ps-4 fw-semibold text-secondary">@item.Id</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Name" class="rounded shadow-sm border border-light" style="width: 50px; height: 50px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-light text-muted d-flex align-items-center justify-content-center shadow-sm border border-light" style="width: 50px; height: 50px;">
                                                <i class="bi bi-image" style="font-size: 20px;"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold text-dark">@item.Name</span>
                                        </div>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 300px;">
                                        @(item.Description ?? "Chưa có mô tả")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(productCount > 0 ? "bg-primary bg-opacity-10 text-primary" : "bg-secondary bg-opacity-10 text-secondary") rounded-pill px-3 py-2 fw-bold" style="font-size: 13px;">
                                            @productCount sản phẩm
                                        </span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            
                                            @* Nếu số lượng sản phẩm > 0 thì ẩn hoàn toàn nút Xóa *@
                                            @if (productCount == 0)
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-trash3-fill"></i> Xóa
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <!-- Chân trang & Phân trang -->
        @{
            int currentPage = ViewBag.CurrentPage ?? 1;
            int totalPages = ViewBag.TotalPages ?? 1;
            int totalItems = ViewBag.TotalItems ?? 0;
        }
        <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3 border-top border-light">
            <div class="text-muted small">
                Hiển thị trang <strong>@currentPage</strong> trên tổng số <strong>@totalPages</strong> trang (Tổng cộng <strong>@totalItems</strong> danh mục)
            </div>
            
            @if (totalPages > 1)
            {
                <nav aria-label="Điều hướng phân trang">
                    <ul class="pagination pagination-sm mb-0 justify-content-center">
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-pill px-3" href="?page=@(currentPage - 1)">Trước</a>
                        </li>
                        
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link px-3" href="?page=@i">@i</a>
                            </li>
                        }
                        
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                            <a class="page-link rounded-end-pill px-3" href="?page=@(currentPage + 1)">Sau</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
        <!-- Chân trang hiển thị thông tin tác giả -->
        <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
            Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
        </div>
    </div>
</div>
