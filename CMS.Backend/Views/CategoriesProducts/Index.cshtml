@model IEnumerable<CMS.Data.Entities.CategoryProduct>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-dark">QUẢN LÝ DANH MỤC SẢN PHẨM</h2>
        <button class="btn btn-success btn-sm">+ Thêm danh mục mới</button>
    </div>
    <table class="table table-hover shadow-sm border">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Tên danh mục</th>
                <th>Mô tả</th>
                <th>Số sản phẩm</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@(item.Description ?? "Chưa có mô tả")</td>
                    <td>
                        <span class="badge bg-primary">@(item.Products != null ? item.Products.Count : 0)</span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-warning">Sửa</button>
                        <button class="btn btn-sm btn-outline-danger">Xóa</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
