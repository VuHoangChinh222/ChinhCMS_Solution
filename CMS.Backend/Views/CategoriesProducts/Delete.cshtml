@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Xác Nhận Xóa Danh Mục Sản Phẩm";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-folder2-open"></i> Danh mục sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Xác nhận xóa</li>
        </ol>
    </nav>

    <!-- Hộp cảnh báo nguy hiểm màu đỏ -->
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">CẢNH BÁO: XÓA DỮ LIỆU VĨNH VIỄN!</h5>
            <p class="mb-0 small">Hành động này không thể hoàn tác. Xin vui lòng kiểm tra kỹ lưỡng các thông tin bên dưới trước khi xác nhận.</p>
        </div>
    </div>

    <div class="row">
        <!-- Cột hiển thị chi tiết danh mục -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h4 class="fw-bold text-dark mb-0">CHI TIẾT DANH MỤC YÊU CẦU XÓA</h4>
                    <hr class="mt-3 mb-0 border-light" />
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold text-muted mb-3">Mã danh mục (ID):</dt>
                        <dd class="col-sm-8 mb-3 text-dark">#@Model.Id</dd>

                        <dt class="col-sm-4 fw-bold text-muted mb-3">Tên danh mục:</dt>
                        <dd class="col-sm-8 mb-3 fw-bold text-danger">@Model.Name</dd>

                        <dt class="col-sm-4 fw-bold text-muted mb-0">Mô tả ngắn:</dt>
                        <dd class="col-sm-8 mb-0 text-muted">@(Model.Description ?? "Không có mô tả chi tiết cho danh mục này")</dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Cột kiểm tra sản phẩm liên kết -->
        <div class="col-lg-6 mb-4">
            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="card border-0 shadow-sm rounded-3 border-start border-warning border-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h4 class="fw-bold text-warning mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-exclamation"></i> KHÔNG THỂ XÓA!
                        </h4>
                        <hr class="mt-3 mb-0 border-light" />
                    </div>
                    <div class="card-body p-4">
                        <p class="text-dark small mb-3">
                            Danh mục này hiện đang chứa <strong>@Model.Products.Count</strong> sản phẩm hoạt động. Để bảo vệ tính toàn vẹn của dữ liệu hệ thống, bạn <strong>không được phép xóa</strong> danh mục này cho đến khi di chuyển hết sản phẩm sang danh mục khác.
                        </p>
                        <div class="table-responsive rounded border" style="max-height: 200px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">ID</th>
                                        <th>Tên sản phẩm</th>
                                        <th class="text-end pe-3">Giá bán</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prod in Model.Products)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted">#@prod.Id</td>
                                            <td class="fw-semibold">@prod.Name</td>
                                            <td class="text-end pe-3">@prod.Price.ToString("N0") đ</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-3 border-start border-success border-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h4 class="fw-bold text-success mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check"></i> AN TOÀN ĐỂ XÓA
                        </h4>
                        <hr class="mt-3 mb-0 border-light" />
                    </div>
                    <div class="card-body p-4 d-flex align-items-center justify-content-center flex-column text-center py-5">
                        <span class="p-3 rounded-circle bg-success bg-opacity-10 text-success mb-3">
                            <i class="bi bi-check-circle" style="font-size: 32px;"></i>
                        </span>
                        <p class="text-muted small mb-0 px-3">
                            Không tìm thấy bất kỳ sản phẩm nào liên kết với danh mục này. Bạn có thể tiến hành xóa bỏ vĩnh viễn một cách an toàn.
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Biểu mẫu xác nhận xóa dữ liệu -->
    <div class="card border-0 shadow-sm rounded-3 mt-2">
        <div class="card-body p-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
            <span class="text-muted small">Vui lòng cân nhắc kỹ lưỡng trước khi bấm nút xác nhận xóa.</span>
            
            <form asp-action="Delete" method="post" class="m-0">
                <!-- Lưu giữ mã danh mục cần xóa -->
                <input type="hidden" asp-for="Id" />
                
                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                        <i class="bi bi-x-circle"></i> Hủy bỏ & Quay lại
                    </a>

                    @if (Model.Products != null && Model.Products.Any())
                    {
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1" disabled>
                            <i class="bi bi-lock-fill"></i> Bị khóa (Còn sản phẩm)
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border: none;">
                            <i class="bi bi-trash3-fill"></i> Xác nhận xóa vĩnh viễn
                        </button>
                    }
                </div>
            </form>
        </div>
        <!-- Chân trang hiển thị thông tin tác giả -->
        <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
            Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
        </div>
    </div>
</div>
