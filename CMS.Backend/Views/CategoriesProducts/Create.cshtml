@model CMS.Data.Entities.CategoryProduct

@{
    ViewData["Title"] = "Thêm Mới Danh Mục Sản Phẩm";
    Layout = "_LayoutAdmin";
}

@* /*
 * Sinh viên : Vũ Hoàng Chính
 * Mã sinh viên: 2122110380
 * Lớp: CCQ2211J
 * Ngày tạo: 22/05/2026
 * Version: 1.0
 */ *@

<div class="container-fluid mt-4">
    <!-- Thanh điều hướng liên kết nhanh -->
    <nav aria-label="Đường dẫn liên kết" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 shadow-sm border border-light">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-primary"><i class="bi bi-folder2-open"></i> Danh mục sản phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới danh mục</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <!-- Tiêu đề thẻ -->
                <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                    <h3 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                        <span class="p-2 rounded bg-success bg-opacity-10 text-success">
                            <i class="bi bi-folder-plus"></i>
                        </span>
                        THÊM MỚI DANH MỤC SẢN PHẨM
                    </h3>
                    <p class="text-muted small mb-0">Nhập thông tin bên dưới để đăng ký danh mục sản phẩm mới vào hệ thống.</p>
                    <hr class="mt-3 mb-0 border-light" />
                </div>

                <div class="card-body p-4">
                    <!-- Biểu mẫu gửi dữ liệu lên phương thức Create sử dụng giao thức POST -->
                    <form asp-action="Create" method="post">
                        <!-- Khu vực hiển thị thông báo lỗi tổng hợp -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Trường nhập liệu cho Tên danh mục -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-dark">Tên danh mục sản phẩm <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-tag-fill"></i></span>
                                <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="Ví dụ: Điện tử, Điện lạnh, Gia dụng..." style="background-color: #fff;" />
                            </div>
                            <!-- Hiển thị thông báo lỗi cụ thể -->
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Trường nhập liệu cho Mô tả danh mục -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold text-dark">Mô tả ngắn chi tiết</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả ngắn gọn về đặc điểm của danh mục sản phẩm này..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Khu vực chứa các nút chức năng của biểu mẫu -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle"></i> Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4 py-2 shadow-sm d-inline-flex align-items-center gap-1" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); border: none;">
                                <i class="bi bi-save-fill"></i> Lưu danh mục mới
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Chân trang hiển thị thông tin tác giả -->
                <div class="card-footer bg-white border-0 py-3 text-center text-muted small border-top border-light">
                    Sinh viên thực hiện: <strong>Vũ Hoàng Chính - 2122110380</strong> | Lớp: CCQ2211J
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
